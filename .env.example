# Copy to .env to override. Variables already set in the environment win.
# Hugging Face model id or local checkpoint path.
THX01_MODEL=doofz/THX-01
# cuda | cpu (empty = cuda if available, else cpu)
THX01_DEVICE=
# If set, every /v1/* request must send "Authorization: Bearer <key>".
# Set the same value in the SS14 server environment variable THX01_API_KEY.
THX01_API_KEY=
HOST=127.0.0.1
PORT=8095
